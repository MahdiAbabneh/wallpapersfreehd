<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks the icon into whatever shape the launcher wants, so the
     mark and its ground are given as separate layers instead of one bitmap
     that the mask would crop badly. The monochrome layer is what Android 13's
     themed icons tint. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
